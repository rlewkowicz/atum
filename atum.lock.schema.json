{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atum.dev/schema/lock/v1",
  "title": "Atum resolved state",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "desiredSha256", "resolved", "compatibility", "delivery"],
  "properties": {
    "$schema": {"const": "./atum.lock.schema.json"},
    "schemaVersion": {"const": "atum.dev/lock/v1"},
    "desiredSha256": {"$ref": "#/$defs/hexSha256"},
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clusterReleases", "kubespray", "bigBang", "flux", "packages", "charts", "artifacts", "vendors", "bootstrap"],
      "properties": {
        "clusterReleases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "https://atum.dev/schema/config/v1#/$defs/clusterRelease"}
        },
        "kubespray": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "https://atum.dev/schema/config/v1#/$defs/kubesprayArtifactInventory"}
        },
        "bigBang": {"$ref": "https://atum.dev/schema/config/v1#/$defs/gitSource"},
        "flux": {"$ref": "https://atum.dev/schema/config/v1#/$defs/gitSource"},
        "packages": {
          "type": "array",
          "items": {"$ref": "https://atum.dev/schema/config/v1#/$defs/package"}
        },
        "supportSources": {
          "type": "array",
          "items": {"$ref": "#/$defs/supportSource"}
        },
        "charts": {
          "type": "array",
          "items": {"$ref": "https://atum.dev/schema/config/v1#/$defs/trackedChart"}
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/chartArtifact"}
        },
        "vendors": {
          "type": "array",
          "items": {"$ref": "https://atum.dev/schema/config/v1#/$defs/vendor"}
        },
        "bootstrap": {"$ref": "https://atum.dev/schema/config/v1#/$defs/bootstrap"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kubernetesVersion", "bigBangConstraint", "status", "constraints", "checksums"],
      "properties": {
        "kubernetesVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "bigBangConstraint": {"type": "string", "minLength": 1},
        "status": {"const": "compatible"},
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "constraint"],
            "properties": {
              "id": {"$ref": "#/$defs/nonEmpty"},
              "constraint": {"$ref": "#/$defs/nonEmpty"}
            }
          }
        },
        "checksums": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kubelet", "kubeadm", "kubectl"],
          "properties": {
            "kubelet": {"$ref": "#/$defs/sha256"},
            "kubeadm": {"$ref": "#/$defs/sha256"},
            "kubectl": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "delivery": {"$ref": "#/$defs/imageLock"}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "chartArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "sourceUrl", "chartPath", "name", "version", "upstreamSha256", "archiveSha256", "size", "file", "target"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "kind": {"enum": ["root", "integrated", "generic", "wrapper", "bootstrap"]},
        "sourceUrl": {"$ref": "#/$defs/nonEmpty"},
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "chartPath": {"$ref": "#/$defs/nonEmpty"},
        "name": {"$ref": "#/$defs/nonEmpty"},
        "version": {"$ref": "#/$defs/nonEmpty"},
        "upstreamSha256": {"$ref": "#/$defs/hexSha256"},
        "archiveSha256": {"$ref": "#/$defs/hexSha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "file": {"$ref": "#/$defs/nonEmpty"},
        "target": {"$ref": "#/$defs/nonEmpty"},
        "normalizations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "from", "to"],
            "properties": {
              "path": {"$ref": "#/$defs/nonEmpty"},
              "from": {"$ref": "#/$defs/nonEmpty"},
              "to": {"$ref": "#/$defs/nonEmpty"}
            }
          }
        }
      }
    },

    "supportSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "valuesPath", "chartPath", "source"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "valuesPath": {"$ref": "#/$defs/nonEmpty"},
        "chartPath": {"$ref": "#/$defs/nonEmpty"},
        "source": {"$ref": "https://atum.dev/schema/config/v1#/$defs/gitSource"}
      }
    },
    "hexSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "imageLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "profile", "platform", "inventorySha256", "graphSha256", "images"],
      "properties": {
        "schemaVersion": {"const": "atum.dev/image-lock/v3"},
        "profile": {"$ref": "#/$defs/nonEmpty"},
        "platform": {"const": "linux/amd64"},
        "inventorySha256": {"$ref": "#/$defs/hexSha256"},
        "graphSha256": {"$ref": "#/$defs/hexSha256"},
        "images": {
          "type": "array",
          "items": {"$ref": "#/$defs/lockedImage"}
        }
      }
    },
    "lockedImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "digest", "inputSha256", "delivery"],
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "target": {"$ref": "#/$defs/nonEmpty"},
        "digest": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"const": ""}
          ]
        },
        "inputSha256": {"$ref": "#/$defs/hexSha256"},
        "delivery": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "source", "digest", "sourceProfile"],
              "properties": {
                "type": {"const": "mirror"},
                "source": {"$ref": "#/$defs/nonEmpty"},
                "digest": {"$ref": "#/$defs/sha256"},
                "sourceProfile": {"$ref": "#/$defs/nonEmpty"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "bakeTarget", "materials", "sourceProfile"],
              "properties": {
                "type": {"const": "build"},
                "bakeTarget": {"$ref": "#/$defs/nonEmpty"},
                "materials": {"type": "array", "items": {"$ref": "#/$defs/nonEmpty"}},
                "sourceProfile": {"$ref": "#/$defs/nonEmpty"}
              }
            }
          ]
        }
      }
    }
  }
}
