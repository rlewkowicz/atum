ARG ATUM_DEBIAN_IMAGE
ARG ATUM_IMAGE_LICENSE
ARG ATUM_IMAGE_SOURCE

FROM ${ATUM_DEBIAN_IMAGE} AS garage-init-helper
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSE
ARG ATUM_IMAGE_SOURCE
ARG ATUM_IMAGE_VERSION
COPY compat/debian/debian.sources /etc/apt/sources.list.d/debian.sources
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      bash \
      ca-certificates \
      coreutils \
      curl \
      jq; \
    rm -rf /var/lib/apt/lists/*
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSE}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="garage-init-helper" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"
USER 1000:1000

FROM ${ATUM_DEBIAN_IMAGE} AS kubectl-helper
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSE
ARG ATUM_IMAGE_SOURCE
ARG ATUM_IMAGE_VERSION
COPY compat/debian/debian.sources /etc/apt/sources.list.d/debian.sources
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      bash \
      ca-certificates \
      coreutils \
      grep \
      mawk; \
    ln -sfn /bin/bash /bin/sh; \
    rm -rf /var/lib/apt/lists/*
COPY --from=atum_kubectl_upstream /bin/kubectl /usr/local/bin/kubectl
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSE}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="kubectl-helper" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"
USER 1000:1000
ENTRYPOINT ["kubectl"]

FROM ${ATUM_DEBIAN_IMAGE} AS grafana-plugin-unpack
COPY compat/debian/debian.sources /etc/apt/sources.list.d/debian.sources
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y unzip; \
    rm -rf /var/lib/apt/lists/*
ADD --checksum=sha256:c8637c0331eb0270cb127e19ea0d839b2b4107aecb27ed518d0794d90ffcb52e \
    https://github.com/grafana/piechart-panel/releases/download/v1.6.4/grafana-piechart-panel-1.6.4.zip \
    /tmp/grafana-piechart-panel.zip
ADD --checksum=sha256:3e1791f83b4db03134dac24521a52407c1990a1b56356dc440580ee4664f214c \
    https://github.com/grafana/grafana-polystat-panel/releases/download/v2.1.16/grafana-polystat-panel-2.1.16.zip \
    /tmp/grafana-polystat-panel.zip
ADD --checksum=sha256:6b86adf28d7ce5748ec8dc5964a7dbd3f8f5095a0a43d259c74a1fa0f501a8ab \
    https://github.com/RedisGrafana/grafana-redis-datasource/releases/download/v2.2.0/redis-datasource-2.2.0.zip \
    /tmp/redis-datasource.zip
RUN set -eux; \
    install -d \
      /out/bb-plugins/piechart-panel \
      /out/bb-plugins/polystat-panel \
      /out/bb-plugins/redis-datasource; \
    unzip -q /tmp/grafana-piechart-panel.zip -d /out/bb-plugins/piechart-panel; \
    unzip -q /tmp/grafana-polystat-panel.zip -d /out/bb-plugins/polystat-panel; \
    unzip -q /tmp/redis-datasource.zip -d /out/bb-plugins/redis-datasource

FROM atum_grafana_upstream AS grafana-plugins
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSE
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE
ARG ATUM_IMAGE_VERSION
USER root
COPY --from=grafana-plugin-unpack --chown=472:0 /out/bb-plugins /var/lib/bb-plugins
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSE}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="grafana-plugins" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"
USER 472

FROM atum_postgresql_upstream AS postgresql-compat
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSE
ARG ATUM_IMAGE_SOURCE
ARG ATUM_IMAGE_VERSION
USER root
RUN set -eux; \
    groupmod --gid 1001 postgres; \
    usermod --uid 1001 --gid 1001 postgres; \
    install -d -o 1001 -g 1001 \
      /bitnami/postgresql \
      /opt/bitnami/postgresql/conf/conf.d \
      /opt/bitnami/postgresql/tmp \
      /var/lib/postgresql; \
    chown -R 1001:1001 /bitnami /opt/bitnami /var/lib/postgresql
COPY --chmod=0755 compat/postgresql/entrypoint.sh /usr/local/bin/atum-postgresql-entrypoint
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSE}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="postgresql-bitnami-chart-compat" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"
USER 1001:1001
ENTRYPOINT ["/usr/local/bin/atum-postgresql-entrypoint"]
CMD ["postgres"]

FROM atum_vault_upstream AS vault-curl-compat
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSE
ARG ATUM_IMAGE_SOURCE
ARG ATUM_IMAGE_VERSION
USER root
COPY --from=atum_curl_upstream /usr/bin/curl /usr/local/lib/atum-curl/curl
COPY --from=atum_curl_upstream /usr/lib/ /usr/local/lib/atum-curl/
COPY --chmod=0755 compat/vault/curl /usr/bin/curl
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSE}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="vault-official-curl-compat" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"
