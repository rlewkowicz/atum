FROM atum_go AS nginx-build
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      libpcre2-dev \
      libssl-dev \
      zlib1g-dev; \
    rm -rf /var/lib/apt/lists/*
COPY --from=nginx_source / /src/nginx
WORKDIR /src/nginx
RUN set -eux; \
    auto/configure \
      --prefix=/opt/atum/nginx \
      --sbin-path=/opt/atum/nginx/sbin/nginx \
      --conf-path=/etc/nginx/nginx.conf \
      --error-log-path=/dev/stderr \
      --http-log-path=/dev/stdout \
      --pid-path=/tmp/nginx.pid \
      --lock-path=/tmp/nginx.lock \
      --http-client-body-temp-path=/var/cache/nginx/client_temp \
      --http-proxy-temp-path=/var/cache/nginx/proxy_temp \
      --http-fastcgi-temp-path=/var/cache/nginx/fastcgi_temp \
      --http-uwsgi-temp-path=/var/cache/nginx/uwsgi_temp \
      --http-scgi-temp-path=/var/cache/nginx/scgi_temp \
      --with-http_gzip_static_module \
      --with-http_ssl_module \
      --with-http_stub_status_module \
      --with-threads; \
    make -j"$(nproc)"; \
    make install

FROM atum_runtime AS harbor-nginx-runtime
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      libpcre2-8-0 \
      libssl3t64 \
      zlib1g; \
    rm -rf /var/lib/apt/lists/*; \
    groupadd --gid 10000 nginx; \
    useradd --no-create-home --home-dir /home/nginx --shell /usr/sbin/nologin \
      --uid 10000 --gid 10000 nginx; \
    mkdir -p /etc/nginx /home/nginx /run /var/cache/nginx /var/log/nginx; \
    chown -R 10000:10000 /etc/nginx /home/nginx /run /var/cache/nginx /var/log/nginx
COPY --from=nginx-build /opt/atum/nginx/sbin/nginx /usr/sbin/nginx
COPY --from=nginx-build /etc/nginx/mime.types /etc/nginx/mime.types
STOPSIGNAL SIGQUIT
USER 10000:10000
CMD ["/usr/sbin/nginx", "-g", "daemon off;"]

FROM harbor-nginx-runtime AS harbor-nginx
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES=Apache-2.0 AND BSD-2-Clause
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE
ARG ATUM_IMAGE_TITLE=harbor-nginx
ARG ATUM_IMAGE_VERSION=2.15.1
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"

FROM atum_node AS harbor-portal-build
COPY --from=harbor_source / /src/harbor
WORKDIR /src/harbor/src/portal
RUN --mount=type=cache,id=atum-npm,target=/root/.npm,sharing=shared \
    set -eux; \
    npm install --package-lock-only --ignore-scripts --save-exact --no-audit --no-fund \
      cytoscape@3.34.1 d3-selection@3.0.0; \
    node -e "const p=require('./package-lock.json').packages; if(p['node_modules/cytoscape'].integrity!=='sha512-Lr0RvH9H75y9ar8h9Toy6u4lxRSCcxUq+hHcQ26sVWo6BnaQp1gwEZOYqwuYTZhyW7npyKnNLP8oJ2p1/3OZ7g=='||p['node_modules/d3-selection'].integrity!=='sha512-fmTRWbNMmsmWq6xJV8D19U/gw/bwrHfNXxrIN+HfZgnzqTHp9jOmKMhsTUjXOJnZOdZY9Q28y4yebKzqDKlxlQ==')process.exit(1)"; \
    npm ci --unsafe-perm --no-audit --no-fund; \
    node --max_old_space_size=2048 node_modules/@angular/cli/bin/ng build --configuration production; \
    node -e "const yaml=require('js-yaml'),fs=require('fs');const value=yaml.load(fs.readFileSync('../../api/v2.0/swagger.yaml','utf8'));fs.writeFileSync('/tmp/swagger.json',JSON.stringify(value));"; \
    cd app-swagger-ui; \
    npm ci --unsafe-perm --no-audit --no-fund; \
    npm run build

FROM harbor-nginx-runtime AS harbor-portal
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES=Apache-2.0 AND BSD-2-Clause
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE
ARG ATUM_IMAGE_TITLE=harbor-portal
ARG ATUM_IMAGE_VERSION=2.15.1
COPY --from=harbor-portal-build /src/harbor/src/portal/dist /usr/share/nginx/html
COPY --from=harbor-portal-build /tmp/swagger.json /usr/share/nginx/html/swagger.json
COPY --from=harbor-portal-build /src/harbor/src/portal/app-swagger-ui/dist /usr/share/nginx/html
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"

FROM atum_go AS harbor-swagger-build
COPY --from=go_swagger_source / /src/go-swagger
WORKDIR /src/go-swagger
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -o /out/swagger ./cmd/swagger

FROM atum_go AS harbor-services-build
COPY --from=harbor_source / /src/harbor
COPY --from=harbor-swagger-build /out/swagger /usr/local/bin/swagger
WORKDIR /src/harbor/src
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    rm -rf server/v2.0/models server/v2.0/restapi; \
    swagger generate server \
      --template-dir=/src/harbor/tools/swagger/templates \
      --exclude-main \
      --additional-initialism=CVE \
      --additional-initialism=GC \
      --additional-initialism=OIDC \
      -f /src/harbor/api/v2.0/swagger.yaml \
      -A harbor \
      --target /src/harbor/src/server/v2.0; \
    mkdir -p /out; \
    (CGO_ENABLED=0 go build -trimpath -buildvcs=false \
      -ldflags='-s -w -X github.com/goharbor/harbor/src/pkg/version.GitCommit=335c05f2b9507b4c7116fe69b84e31ef9f4b91dd -X github.com/goharbor/harbor/src/pkg/version.ReleaseVersion=v2.15.1' \
      -o /out/harbor_core ./core) & \
    atum_core_pid=$!; \
    (CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' \
      -o /out/harbor_jobservice ./jobservice) & \
    atum_job_pid=$!; \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' \
      -o /out/harbor_registryctl ./registryctl; \
    wait "$atum_core_pid"; \
    wait "$atum_job_pid"

FROM atum_go AS harbor-distribution-build
COPY --from=distribution_source / /go/src/github.com/docker/distribution
WORKDIR /go/src/github.com/docker/distribution
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    set -eux; \
    mkdir -p /out; \
    GO111MODULE=off CGO_ENABLED=0 go build -trimpath \
      -tags='include_oss include_gcs' \
      -ldflags='-s -w -X github.com/docker/distribution/version.Version=v2.8.3-patch-redis -X github.com/docker/distribution/version.Revision=086d3c33b3981cf598d0d82336a907fcf5c4c848 -X github.com/docker/distribution/version.Package=github.com/docker/distribution' \
      -o /out/registry ./cmd/registry

FROM atum_runtime AS harbor-service-runtime
COPY compat/lib/atum.sh /usr/local/lib/atum/atum.sh
COPY compat/harbor/component-entrypoint.sh /usr/local/bin/harbor-entrypoint
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y tzdata; \
    rm -rf /var/lib/apt/lists/*; \
    groupadd --gid 10000 harbor; \
    useradd --no-create-home --home-dir /home/harbor --shell /usr/sbin/nologin \
      --uid 10000 --gid 10000 harbor; \
    mkdir -p /etc/harbor/ssl /etc/registry /harbor /harbor_cust_cert /home/harbor \
      /storage /var/lib/registry /var/log/jobs; \
    chown -R 10000:10000 /etc/harbor/ssl /etc/registry /harbor /harbor_cust_cert /home/harbor \
      /storage /var/lib/registry /var/log/jobs \
      /etc/ssl/certs/ca-certificates.crt; \
    chmod 0755 /usr/local/bin/harbor-entrypoint /usr/local/lib/atum/atum.sh
ENTRYPOINT ["/usr/local/bin/harbor-entrypoint"]
USER 10000:10000

FROM harbor-service-runtime AS harbor-core
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES=Apache-2.0
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE=https://github.com/goharbor/harbor
ARG ATUM_IMAGE_TITLE=harbor-core
ARG ATUM_IMAGE_VERSION=2.15.1
COPY --from=harbor-services-build --chown=10000:10000 /out/harbor_core /harbor/harbor_core
COPY --from=harbor_source --chown=10000:10000 /src/core/views /harbor/views
COPY --from=harbor_source --chown=10000:10000 /make/migrations /harbor/migrations
COPY --from=harbor_source --chown=10000:10000 /icons /harbor/icons
ENV ATUM_HARBOR_COMPONENT=core
WORKDIR /harbor
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"

FROM harbor-service-runtime AS harbor-jobservice
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES=Apache-2.0
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE=https://github.com/goharbor/harbor
ARG ATUM_IMAGE_TITLE=harbor-jobservice
ARG ATUM_IMAGE_VERSION=2.15.1
COPY --from=harbor-services-build --chown=10000:10000 /out/harbor_jobservice /harbor/harbor_jobservice
ENV ATUM_HARBOR_COMPONENT=jobservice
WORKDIR /harbor
VOLUME ["/var/log/jobs"]
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"

FROM harbor-service-runtime AS harbor-registry
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES=Apache-2.0
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE
ARG ATUM_IMAGE_TITLE=harbor-registry
ARG ATUM_IMAGE_VERSION=2.15.1
COPY --from=harbor-distribution-build --chown=10000:10000 /out/registry /usr/bin/registry_DO_NOT_USE_GC
ENV ATUM_HARBOR_COMPONENT=registry
VOLUME ["/storage"]
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"

FROM harbor-service-runtime AS harbor-registryctl
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES=Apache-2.0
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE
ARG ATUM_IMAGE_TITLE=harbor-registryctl
ARG ATUM_IMAGE_VERSION=2.15.1
COPY --from=harbor-services-build --chown=10000:10000 /out/harbor_registryctl /home/harbor/harbor_registryctl
COPY --from=harbor-distribution-build --chown=10000:10000 /out/registry /usr/bin/registry_DO_NOT_USE_GC
ENV ATUM_HARBOR_COMPONENT=registryctl
VOLUME ["/var/lib/registry"]
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"

FROM atum_go AS harbor-postgresql-build-base
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y bison flex; \
    rm -rf /var/lib/apt/lists/*

FROM harbor-postgresql-build-base AS harbor-postgresql-15-build
COPY --from=postgresql_15_source / /src/postgresql
WORKDIR /src/postgresql
RUN set -eux; \
    ./configure --prefix=/opt/atum/postgresql/15 --without-icu --without-readline --without-zlib; \
    make -j"$(nproc)"; \
    make install-strip

FROM harbor-postgresql-build-base AS harbor-postgresql-18-build
COPY --from=postgresql_18_source / /src/postgresql
WORKDIR /src/postgresql
RUN set -eux; \
    ./configure --prefix=/opt/atum/postgresql/18 --without-icu --without-readline --without-zlib; \
    make -j"$(nproc)"; \
    make install-strip

FROM atum_runtime AS harbor-database
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES=PostgreSQL AND Apache-2.0
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE
ARG ATUM_IMAGE_TITLE=harbor-database
ARG ATUM_IMAGE_VERSION=18.3
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      gzip \
      locales; \
    sed -ri 's/^# (en_US.UTF-8 UTF-8)$/\1/' /etc/locale.gen; \
    locale-gen; \
    rm -rf /var/lib/apt/lists/*; \
    groupadd --gid 999 postgres; \
    useradd --no-create-home --home-dir /var/lib/postgresql --shell /bin/sh \
      --uid 999 --gid 999 postgres; \
    mkdir -p /docker-entrypoint-initdb.d /run/postgresql /var/lib/postgresql/data; \
    chown -R 999:999 /docker-entrypoint-initdb.d /run/postgresql /var/lib/postgresql; \
    chmod 2775 /run/postgresql
COPY --from=harbor-postgresql-15-build /opt/atum/postgresql/15 /opt/atum/postgresql/15
COPY --from=harbor-postgresql-18-build /opt/atum/postgresql/18 /opt/atum/postgresql/18
COPY --from=harbor_source --chown=999:999 /make/photon/db/initial-registry.sql /docker-entrypoint-initdb.d/initial-registry.sql
COPY compat/lib/atum.sh /usr/local/lib/atum/atum.sh
COPY compat/harbor/database-entrypoint.sh /docker-entrypoint.sh
COPY compat/harbor/database-healthcheck.sh /docker-healthcheck.sh
RUN chmod 0755 /usr/local/lib/atum/atum.sh /docker-entrypoint.sh /docker-healthcheck.sh
ENV PATH=/opt/atum/postgresql/18/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PGDATA=/var/lib/postgresql/data
VOLUME ["/var/lib/postgresql/data"]
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"
USER 999:999
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["postgres"]

FROM atum_go AS harbor-redis-build
COPY --from=redis_source / /src/redis
WORKDIR /src/redis
RUN set -eux; \
    make -j"$(nproc)" BUILD_TLS=no MALLOC=libc; \
    install -D -m 0755 src/redis-server /out/redis-server; \
    install -D -m 0755 src/redis-cli /out/redis-cli; \
    install -D -m 0755 src/redis-check-aof /out/redis-check-aof; \
    install -D -m 0755 src/redis-check-rdb /out/redis-check-rdb

FROM atum_runtime AS harbor-redis
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES=AGPL-3.0-only AND Apache-2.0
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE
ARG ATUM_IMAGE_TITLE=harbor-redis
ARG ATUM_IMAGE_VERSION=8.6.1
RUN set -eux; \
    groupadd --gid 999 redis; \
    useradd --no-create-home --home-dir /var/lib/redis --shell /usr/sbin/nologin \
      --uid 999 --gid 999 redis; \
    mkdir -p /var/lib/redis; \
    chown 999:999 /var/lib/redis
COPY --from=harbor-redis-build /out/ /usr/local/bin/
COPY --from=harbor_source /make/photon/redis/redis.conf /etc/redis.conf
COPY compat/harbor/redis-healthcheck.sh /usr/local/bin/docker-healthcheck
RUN chmod 0755 /usr/local/bin/docker-healthcheck; chown 999:999 /etc/redis.conf
WORKDIR /var/lib/redis
VOLUME ["/var/lib/redis"]
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"
USER 999:999
CMD ["/usr/local/bin/redis-server", "/etc/redis.conf"]
