FROM atum_go AS istio-build
COPY --from=istio_source / /src/istio
WORKDIR /src/istio
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    mkdir -p /out; \
    atum_ldflags='-s -w \
      -X istio.io/istio/pkg/version.buildVersion=1.29.2 \
      -X istio.io/istio/pkg/version.buildGitRevision=0c774325b938c4dbda4ea4ad4fb6156e80a12de8 \
      -X istio.io/istio/pkg/version.buildStatus=Clean \
      -X istio.io/istio/pkg/version.buildTag=1.29.2 \
      -X istio.io/istio/pkg/version.buildHub=10.77.0.9:32443/atum \
      -X istio.io/istio/pkg/version.buildOS=linux \
      -X istio.io/istio/pkg/version.buildArch=amd64'; \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags="$atum_ldflags" \
      -o /out/pilot-discovery ./pilot/cmd/pilot-discovery & \
    atum_pilot_pid=$!; \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags="$atum_ldflags" \
      -o /out/pilot-agent ./pilot/cmd/pilot-agent; \
    wait "$atum_pilot_pid"

FROM atum_go AS ncurses-abi5-build
COPY --from=ncurses_source / /src/ncurses
WORKDIR /src/ncurses
RUN set -eux; \
    ./configure \
      --prefix=/opt/atum/ncurses-abi5 \
      --with-shared \
      --without-normal \
      --without-debug \
      --without-ada \
      --without-cxx \
      --without-progs \
      --without-tests \
      --without-manpages \
      --with-abi-version=5 \
      --with-versioned-syms \
      --with-termlib; \
    make -j"$(nproc)"; \
    install -D -m 0755 lib/libtinfo.so.5.9 /out/libtinfo.so.5; \
    readelf -d /out/libtinfo.so.5 | grep -F 'Library soname: [libtinfo.so.5]'; \
    readelf --version-info /out/libtinfo.so.5 | grep -F 'NCURSES_TINFO_5.0.19991023'

FROM atum_go AS envoy-build
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      clang \
      cmake \
      curl \
      git \
      libc++-dev \
      libc++abi-dev \
      libssl-dev \
      ninja-build \
      openjdk-21-jdk-headless \
      patch \
      python3 \
      unzip \
      zip; \
    rm -rf /var/lib/apt/lists/*; \
    curl --fail --location --retry 6 \
      --output /usr/local/bin/bazel \
      https://github.com/bazelbuild/bazel/releases/download/7.7.1/bazel-7.7.1-linux-x86_64; \
    printf '%s  %s\n' \
      115a1b62be95f29e5821d4dddffba1b058905a48019b499919c285e7f708d5e2 \
      /usr/local/bin/bazel | sha256sum --check; \
    chmod 0755 /usr/local/bin/bazel
COPY --from=ncurses-abi5-build /out/libtinfo.so.5 /usr/lib/x86_64-linux-gnu/libtinfo.so.5
COPY --from=istio_proxy_source / /src/proxy
WORKDIR /src/proxy
RUN --mount=type=cache,id=atum-bazel-repository,target=/root/.cache/bazel-repository,sharing=locked \
    --mount=type=cache,id=atum-bazel-output,target=/root/.cache/bazel-output,sharing=locked \
    set -eux; \
    BUILD_SCM_REVISION=af30be60b7c35f2aceaea1b7382c7fbf12aa5e67 \
    BUILD_SCM_STATUS=Clean \
    BUILD_CONFIG=release \
    bazel --batch \
      --output_base=/root/.cache/bazel-output \
      build \
      --repository_cache=/root/.cache/bazel-repository \
      --config=release \
      --jobs="$(nproc)" \
      //:envoy; \
    install -D -m 0755 bazel-bin/envoy /out/envoy

FROM atum_node AS kiali-ui-build
COPY --from=kiali_source / /src/kiali
WORKDIR /src/kiali/frontend
RUN --mount=type=cache,id=atum-yarn,target=/root/.cache/yarn,sharing=shared \
    set -eux; \
    corepack enable; \
    yarn install --immutable; \
    yarn run build

FROM atum_go AS kiali-build
COPY --from=kiali_source / /src/kiali
COPY --from=kiali-ui-build /src/kiali/frontend/build /src/kiali/frontend/build
WORKDIR /src/kiali
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    mkdir -p /out; \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false \
      -ldflags='-s -w -X github.com/kiali/kiali/cmd.version=v2.25.0 -X github.com/kiali/kiali/cmd.commitHash=3292851b81f45968bcce5a7da6afad880bdf67d6' \
      -o /out/kiali .

FROM atum_go AS ansible-operator-build
COPY --from=ansible_operator_source / /src/ansible-operator
WORKDIR /src/ansible-operator
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' \
      -o /out/ansible-operator ./cmd/ansible-operator

FROM atum_python AS ansible-runtime-build
RUN set -eux; \
    python3.12 -m pip install --no-cache-dir pipenv==2023.11.15
COPY --from=ansible_operator_source /images/ansible-operator/Pipfile /tmp/ansible/Pipfile
COPY --from=ansible_operator_source /images/ansible-operator/Pipfile.lock /tmp/ansible/Pipfile.lock
WORKDIR /tmp/ansible
RUN --mount=type=cache,id=atum-pip,target=/root/.cache/pip,sharing=shared \
    set -eux; \
    PIPENV_PIPFILE=/tmp/ansible/Pipfile pipenv sync --system
COPY --from=ansible_community_general_source / /tmp/collections/community/general
COPY --from=ansible_kubernetes_core_source / /tmp/collections/kubernetes/core
COPY --from=ansible_operator_util_source / /tmp/collections/operator_sdk/util
COPY --from=ansible_posix_source / /tmp/collections/ansible/posix
RUN set -eux; \
    mkdir -p /opt/ansible/.ansible/collections/ansible_collections; \
    cp -a /tmp/collections/. /opt/ansible/.ansible/collections/ansible_collections/

FROM atum_runtime AS mesh-runtime
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE
ARG ATUM_IMAGE_TITLE
ARG ATUM_IMAGE_VERSION
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"

FROM mesh-runtime AS istio-pilot
COPY --from=istio-build /out/pilot-discovery /usr/local/bin/pilot-discovery
USER 1337:1337
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/pilot-discovery"]

FROM mesh-runtime AS istio-proxy
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      iproute2 \
      iptables \
      libatomic1 \
      libcap2-bin; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p /etc/istio/proxy /var/lib/istio /var/run/secrets /var/run/secrets/istio; \
    chown -R 1337:1337 /etc/istio /var/lib/istio /var/run/secrets
COPY --from=istio-build /out/pilot-agent /usr/local/bin/pilot-agent
COPY --from=envoy-build /out/envoy /usr/local/bin/envoy
USER 1337:1337
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/pilot-agent"]

FROM mesh-runtime AS kiali-server
RUN set -eux; \
    groupadd --gid 1000 kiali; \
    useradd --no-create-home --home-dir /opt/kiali --shell /usr/sbin/nologin \
      --uid 1000 --gid 1000 kiali; \
    mkdir -p /opt/kiali; \
    chown 1000:1000 /opt/kiali
COPY --from=kiali-build --chown=1000:1000 /out/kiali /opt/kiali/kiali
WORKDIR /opt/kiali
USER 1000:1000
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/kiali/kiali"]

FROM mesh-runtime AS kiali-operator
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      git \
      libbz2-1.0 \
      libffi8 \
      liblzma5 \
      libreadline8t64 \
      libsqlite3-0 \
      libssl3t64 \
      zlib1g; \
    rm -rf /var/lib/apt/lists/*; \
    printf 'ansible:x:1001:0:Ansible operator:/opt/ansible:/usr/sbin/nologin\n' >> /etc/passwd; \
    mkdir -p /etc/ansible /opt/ansible/.ansible/tmp; \
    printf 'localhost ansible_connection=local\n' > /etc/ansible/hosts; \
    printf '[defaults]\nroles_path = /opt/ansible/roles\n' > /etc/ansible/ansible.cfg; \
    chown -R 1001:0 /opt/ansible; \
    chmod -R g=u /opt/ansible
COPY --from=ansible-runtime-build --chown=1001:0 /opt/atum/python /opt/atum/python
COPY --from=ansible-runtime-build --chown=1001:0 /opt/ansible /opt/ansible
COPY --from=ansible-operator-build /out/ansible-operator /usr/local/bin/ansible-operator
COPY --from=kiali_operator_source --chown=1001:0 /roles /opt/ansible/roles
COPY --from=kiali_operator_source --chown=1001:0 /playbooks /opt/ansible/playbooks
COPY --from=kiali_operator_source --chown=1001:0 /watches-k8s.yaml /opt/ansible/watches-k8s.yaml
COPY --from=kiali_operator_source --chown=1001:0 /watches-os.yaml /opt/ansible/watches-os.yaml
ENV HOME=/opt/ansible \
    LD_LIBRARY_PATH=/opt/atum/python/lib \
    PATH=/opt/atum/python/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /opt/ansible
USER 1001:0
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/ansible-operator", "run"]
CMD ["--watches-file=/opt/ansible/watches-k8s.yaml"]
