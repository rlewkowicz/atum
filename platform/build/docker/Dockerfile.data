FROM atum_runtime AS keycloak-build
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      libicu76 openjdk-21-jdk-headless unzip; \
    rm -rf /var/lib/apt/lists/*
COPY --from=keycloak_source / /src/keycloak
WORKDIR /src/keycloak
RUN --mount=type=cache,id=atum-maven,target=/root/.m2,sharing=shared \
    set -eux; \
    KIOTA_VERSION=v1.31.1 ./mvnw --batch-mode --no-transfer-progress \
      -pl quarkus/dist -am \
      -DskipTests -DskipTestsuite -DskipExamples -DskipDocs \
      -Dproject.build.outputTimestamp=1970-01-01T00:00:00Z \
      package; \
    atum_archive="$(find quarkus/dist/target -maxdepth 1 -type f -name 'keycloak-*.zip' -print -quit)"; \
    test -n "$atum_archive"; \
    mkdir -p /out/keycloak; \
    unzip -q "$atum_archive" -d /tmp/keycloak; \
    cp -a /tmp/keycloak/keycloak-*/. /out/keycloak/

FROM atum_runtime AS postgresql-build-base
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      bison \
      build-essential \
      flex \
      libicu-dev \
      libldap2-dev \
      liblz4-dev \
      libpam0g-dev \
      libreadline-dev \
      libssl-dev \
      libxml2-dev \
      libxslt1-dev \
      libzstd-dev \
      pkg-config \
      uuid-dev \
      zlib1g-dev; \
    rm -rf /var/lib/apt/lists/*

FROM postgresql-build-base AS postgresql-17-build
COPY --from=postgresql_17_source / /src/postgresql
WORKDIR /src/postgresql
RUN set -eux; \
    ./configure \
      --prefix=/opt/bitnami/postgresql \
      --with-icu \
      --with-ldap \
      --with-libxml \
      --with-libxslt \
      --with-lz4 \
      --with-openssl \
      --with-pam \
      --with-uuid=e2fs \
      --with-zstd; \
    make -j"$(nproc)" world-bin; \
    make install-world-bin DESTDIR=/out

FROM postgresql-build-base AS postgresql-18-build
COPY --from=postgresql_18_source / /src/postgresql
WORKDIR /src/postgresql
RUN set -eux; \
    ./configure \
      --prefix=/opt/bitnami/postgresql \
      --with-icu \
      --with-ldap \
      --with-libxml \
      --with-libxslt \
      --with-lz4 \
      --with-openssl \
      --with-pam \
      --with-uuid=e2fs \
      --with-zstd; \
    make -j"$(nproc)" world-bin; \
    make install-world-bin DESTDIR=/out

FROM atum_runtime AS redis-build-base
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      build-essential libssl-dev pkg-config; \
    rm -rf /var/lib/apt/lists/*

FROM redis-build-base AS redis-8-4-build
COPY --from=redis_8_4_source / /src/redis
WORKDIR /src/redis
RUN set -eux; \
    make -j"$(nproc)" BUILD_TLS=yes MALLOC=libc USE_SYSTEMD=no; \
    make install BUILD_TLS=yes MALLOC=libc USE_SYSTEMD=no PREFIX=/out/opt/bitnami/redis

FROM redis-build-base AS bigbang-harbor-redis-build
COPY --from=redis_source / /src/redis
WORKDIR /src/redis
RUN set -eux; \
    make -j"$(nproc)" BUILD_TLS=yes MALLOC=libc USE_SYSTEMD=no; \
    make install BUILD_TLS=yes MALLOC=libc USE_SYSTEMD=no PREFIX=/out/opt/bitnami/redis

FROM atum_go AS redis-exporter-build
COPY --from=redis_exporter_source / /src/redis-exporter
WORKDIR /src/redis-exporter
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false \
      -ldflags='-s -w -X main.BuildVersion=v1.86.0 -X main.BuildCommitSha=c4dac6ba37ea9c7da7652beb329612af977106aa -X main.BuildDate=1970-01-01T00:00:00Z' \
      -o /out/redis_exporter .

FROM atum_go AS minio-build
COPY --from=minio_source / /src/minio
WORKDIR /src/minio
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -tags=kqueue \
      -ldflags='-s -w -X github.com/minio/minio/cmd.Version=2024-06-04T19-20-08Z -X github.com/minio/minio/cmd.CopyrightYear=2024 -X github.com/minio/minio/cmd.ReleaseTag=RELEASE.2024-06-04T19-20-08Z -X github.com/minio/minio/cmd.CommitID=17fe91d6d162b3ad372760726d29f1f348dbdb09 -X github.com/minio/minio/cmd.ShortCommitID=17fe91d6d162' \
      -o /out/minio .

FROM atum_go AS minio-client-build
COPY --from=minio_client_source / /src/minio-client
WORKDIR /src/minio-client
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -tags=kqueue \
      -ldflags='-s -w -X github.com/minio/mc/cmd.Version=2024-10-02T08-27-28Z -X github.com/minio/mc/cmd.CopyrightYear=2024 -X github.com/minio/mc/cmd.ReleaseTag=RELEASE.2024-10-02T08-27-28Z -X github.com/minio/mc/cmd.CommitID=ce0b4341521de16ae2172d42054bbe054f9c9651 -X github.com/minio/mc/cmd.ShortCommitID=ce0b4341521d' \
      -o /out/mc .

FROM atum_node_20 AS openbao-ui-build
COPY --from=openbao_source / /src/openbao
WORKDIR /src/openbao/ui
RUN --mount=type=cache,id=atum-yarn-openbao,target=/root/.yarn/berry/cache,sharing=shared \
    --mount=type=cache,id=atum-npm,target=/root/.npm,sharing=shared \
    set -eux; \
    mkdir -p ../http/web_ui; \
    YARN_ENABLE_PROGRESS_BARS=false node .yarn/releases/yarn-3.5.0.cjs install --immutable; \
    npm rebuild node-sass; \
    node .yarn/releases/yarn-3.5.0.cjs run build; \
    test -s ../http/web_ui/index.html

FROM atum_go AS openbao-build
COPY --from=openbao_source / /src/openbao
COPY --from=openbao-ui-build /src/openbao/http/web_ui /src/openbao/http/web_ui
WORKDIR /src/openbao
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -tags='openbao ui' \
      -ldflags='-s -w -X github.com/openbao/openbao/version.GitCommit=988c88d7ef54b4d4581629b229488dfba5e085ba -X github.com/openbao/openbao/version.BuildDate=1970-01-01T00:00:00Z' \
      -o /out/bao .

FROM atum_go AS vault-k8s-build
ARG ATUM_IMAGE_VERSION
COPY --from=vault_k8s_source / /src/vault-k8s
WORKDIR /src/vault-k8s
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false \
      -ldflags="-s -w -X github.com/hashicorp/vault-k8s/version.Version=v${ATUM_IMAGE_VERSION}" \
      -o /out/vault-k8s .

FROM atum_runtime AS opensearch-build
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      git openjdk-21-jdk-headless python3 unzip; \
    rm -rf /var/lib/apt/lists/*
COPY --from=opensearch_source / /src/opensearch
WORKDIR /src/opensearch
RUN --mount=type=cache,id=atum-gradle,target=/root/.gradle,sharing=shared \
    set -eux; \
    ./gradlew --no-daemon --console=plain \
      :distribution:archives:no-jdk-linux-tar:assemble; \
    atum_archive="$(find distribution/archives/no-jdk-linux-tar/build/distributions \
      -maxdepth 1 -type f -name '*.tar.gz' -print -quit)"; \
    test -n "$atum_archive"; \
    mkdir -p /out/opensearch; \
    tar -xzf "$atum_archive" --strip-components=1 -C /out/opensearch; \
    sed -i 's/OPENSEARCH_DISTRIBUTION_TYPE=tar/OPENSEARCH_DISTRIBUTION_TYPE=docker/' \
      /out/opensearch/bin/opensearch-env

FROM atum_node AS opensearch-dashboards-build
RUN set -eux; \
    corepack disable; \
    npm install --global --no-audit --no-fund yarn@1.22.19; \
    install -d -o 65532 -g 65532 /out /tmp/atum /tmp/atum/.cache
COPY --chown=65532:65532 --from=opensearch_dashboards_source / /src/opensearch-dashboards
WORKDIR /src/opensearch-dashboards
ENV HOME=/tmp/atum \
    CYPRESS_INSTALL_BINARY=0 \
    OPENSEARCH_DASHBOARDS_NODE_TYPE=production \
    YARN_CACHE_FOLDER=/tmp/atum/.cache/yarn \
    NODE_OPTIONS=--max-old-space-size=8192
USER 65532:65532
RUN --mount=type=cache,id=atum-yarn,target=/tmp/atum/.cache/yarn,uid=65532,gid=65532,sharing=shared \
    set -eux; \
    git init -q; \
    GIT_AUTHOR_DATE=1970-01-01T00:00:00Z \
      GIT_COMMITTER_DATE=1970-01-01T00:00:00Z \
      git -c user.name=atum \
        -c user.email=build@atum.invalid \
        -c commit.gpgsign=false \
        commit -q --allow-empty -m 'source archive'; \
    yarn install --frozen-lockfile; \
    yarn osd bootstrap; \
    yarn build-platform --linux; \
    atum_archive="$(find target -maxdepth 1 -type f -name 'opensearch-dashboards-*-linux-x64.tar.gz' -print -quit)"; \
    test -n "$atum_archive"; \
    mkdir -p /out/opensearch-dashboards; \
    tar -xzf "$atum_archive" --strip-components=1 -C /out/opensearch-dashboards; \
    rm -rf /out/opensearch-dashboards/node

FROM atum_go AS opensearch-operator-build
COPY --from=opensearch_operator_source / /src/opensearch-operator
WORKDIR /src/opensearch-operator/opensearch-operator
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' \
      -o /out/manager .

FROM atum_go AS velero-build
COPY --from=velero_source / /src/velero
WORKDIR /src/velero
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false \
      -ldflags='-s -w -X github.com/vmware-tanzu/velero/pkg/buildinfo.Version=v1.18.0 -X github.com/vmware-tanzu/velero/pkg/buildinfo.ImageRegistry=10.77.0.9:32443/atum -X github.com/vmware-tanzu/velero/pkg/buildinfo.GitSHA=6adcf06b5b0e6fb93998d3e101e2cbdc134fa3c3 -X github.com/vmware-tanzu/velero/pkg/buildinfo.GitTreeState=clean' \
      -o /out/velero ./cmd/velero

FROM atum_go AS velero-aws-build
COPY --from=velero_aws_source / /src/velero-aws
WORKDIR /src/velero-aws
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    mkdir -p /out; \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' \
      -o /out/velero-plugin-for-aws ./velero-plugin-for-aws & \
    atum_velero_plugin_pid=$!; \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' \
      -o /out/cp-plugin ./hack/cp-plugin; \
    wait "$atum_velero_plugin_pid"

FROM atum_runtime AS data-runtime
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE
ARG ATUM_IMAGE_TITLE
ARG ATUM_IMAGE_VERSION
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"

FROM data-runtime AS keycloak
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      bash openjdk-21-jre-headless; \
    rm -rf /var/lib/apt/lists/*; \
    groupadd --gid 1000 keycloak; \
    useradd --no-create-home --home-dir /opt/bitnami/keycloak --shell /usr/sbin/nologin \
      --uid 1000 --gid 1000 keycloak; \
    mkdir -p /opt/bitnami/keycloak; \
    chown -R 1000:1000 /opt/bitnami; \
    chmod -R g=u /opt/bitnami
COPY --from=keycloak-build --chown=1000:1000 /out/keycloak /opt/bitnami/keycloak
COPY --chmod=0755 compat/redis/liblog.sh /opt/bitnami/scripts/liblog.sh
COPY --chmod=0755 compat/keycloak/entrypoint.sh /usr/local/bin/keycloak-entrypoint
ENV KC_HOME=/opt/bitnami/keycloak \
    PATH=/opt/bitnami/keycloak/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /opt/bitnami/keycloak
USER 1000:1000
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/keycloak-entrypoint"]

FROM data-runtime AS postgresql-runtime
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      bash gzip libicu76 libldap2 liblz4-1 libpam0g libreadline8t64 libssl3t64 \
      libxml2 libxslt1.1 libzstd1 locales tzdata uuid-runtime zlib1g; \
    rm -rf /var/lib/apt/lists/*; \
    printf 'postgres:x:1001:0:PostgreSQL:/bitnami/postgresql:/usr/sbin/nologin\n' >> /etc/passwd; \
    mkdir -p \
      /bitnami/postgresql/data \
      /docker-entrypoint-initdb.d \
      /docker-entrypoint-preinitdb.d \
      /opt/bitnami/postgresql/certs \
      /opt/bitnami/postgresql/conf/conf.d \
      /opt/bitnami/postgresql/secrets \
      /opt/bitnami/postgresql/tmp; \
    chown -R 1001:0 /bitnami /docker-entrypoint-initdb.d /docker-entrypoint-preinitdb.d /opt/bitnami; \
    chmod -R g=u /bitnami /docker-entrypoint-initdb.d /docker-entrypoint-preinitdb.d /opt/bitnami
COPY --chmod=0755 compat/lib/atum.sh /usr/local/lib/atum/atum.sh
COPY --chmod=0755 compat/postgresql/entrypoint.sh /usr/local/bin/postgresql-entrypoint
ENV PGDATA=/bitnami/postgresql/data \
    PATH=/opt/bitnami/postgresql/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
USER 1001:0
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/postgresql-entrypoint"]
CMD ["postgres"]

FROM postgresql-runtime AS postgresql-17
COPY --from=postgresql-17-build --chown=1001:0 /out/opt/bitnami/postgresql /opt/bitnami/postgresql

FROM postgresql-runtime AS postgresql-18
COPY --from=postgresql-18-build --chown=1001:0 /out/opt/bitnami/postgresql /opt/bitnami/postgresql

FROM data-runtime AS redis-runtime
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y bash libssl3t64 procps; \
    rm -rf /var/lib/apt/lists/*; \
    printf 'redis:x:1001:0:Redis:/data:/usr/sbin/nologin\n' >> /etc/passwd; \
    mkdir -p \
      /data \
      /opt/bitnami/redis/certs \
      /opt/bitnami/redis/etc \
      /opt/bitnami/redis/mounted-etc \
      /opt/bitnami/redis/secrets \
      /opt/bitnami/redis-sentinel/etc \
      /opt/bitnami/scripts/redis \
      /opt/bitnami/scripts/redis-sentinel; \
    chown -R 1001:0 /data /opt/bitnami; \
    chmod -R g=u /data /opt/bitnami
COPY --chmod=0755 compat/lib/atum.sh /usr/local/lib/atum/atum.sh
COPY --chmod=0755 compat/redis/libfile.sh /opt/bitnami/scripts/libfile.sh
COPY --chmod=0755 compat/redis/liblog.sh /opt/bitnami/scripts/liblog.sh
COPY --chmod=0755 compat/redis/libos.sh /opt/bitnami/scripts/libos.sh
COPY --chmod=0755 compat/redis/libvalidations.sh /opt/bitnami/scripts/libvalidations.sh
COPY --chmod=0755 compat/redis/entrypoint.sh /opt/bitnami/scripts/redis/entrypoint.sh
COPY --chmod=0755 compat/redis/run.sh /opt/bitnami/scripts/redis/run.sh
COPY --chmod=0755 compat/redis/entrypoint.sh /opt/bitnami/scripts/redis-sentinel/entrypoint.sh
COPY --chmod=0755 compat/redis/sentinel-run.sh /opt/bitnami/scripts/redis-sentinel/run.sh
ENV PATH=/opt/bitnami/redis/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /data
USER 1001:0
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/bitnami/scripts/redis/entrypoint.sh"]
CMD ["/opt/bitnami/scripts/redis/run.sh"]

FROM redis-runtime AS redis-8-4
COPY --from=redis-8-4-build --chown=1001:0 /out/opt/bitnami/redis /opt/bitnami/redis

FROM redis-runtime AS bigbang-harbor-redis
COPY --from=bigbang-harbor-redis-build --chown=1001:0 /out/opt/bitnami/redis /opt/bitnami/redis

FROM data-runtime AS redis-exporter
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y bash; \
    rm -rf /var/lib/apt/lists/*; \
    groupadd --gid 1001 redis-exporter; \
    useradd --no-create-home --home-dir /opt/bitnami/redis-exporter --shell /usr/sbin/nologin \
      --uid 1001 --gid 1001 redis-exporter; \
    install -d -o 1001 -g 1001 /opt/bitnami/redis-exporter/bin
COPY --from=redis-exporter-build --chown=1001:1001 /out/redis_exporter /opt/bitnami/redis-exporter/bin/redis_exporter
ENV PATH=/opt/bitnami/redis-exporter/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
USER 1001:1001
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/bitnami/redis-exporter/bin/redis_exporter"]

FROM data-runtime AS minio
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y bash; \
    rm -rf /var/lib/apt/lists/*; \
    printf 'minio:x:1000:0:MinIO:/data:/usr/sbin/nologin\n' >> /etc/passwd; \
    mkdir -p /data /opt/bitnami/minio/secrets; \
    chown -R 1000:0 /data /opt/bitnami; \
    chmod -R g=u /data /opt/bitnami
COPY --from=minio-build /out/minio /usr/local/bin/minio
COPY --chmod=0755 compat/lib/atum.sh /usr/local/lib/atum/atum.sh
COPY --chmod=0755 compat/minio/entrypoint.sh /usr/local/bin/minio-entrypoint
WORKDIR /data
USER 1000:1000
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/minio-entrypoint"]

FROM data-runtime AS minio-client
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y bash; \
    rm -rf /var/lib/apt/lists/*
COPY --from=minio-client-build /out/mc /usr/local/bin/mc
RUN ln -s /usr/local/bin/mc /usr/bin/mc
USER 65532:65532
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/mc"]

FROM data-runtime AS openbao
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y bash curl procps; \
    rm -rf /var/lib/apt/lists/*; \
    ln -sf bash /bin/sh; \
    groupadd --gid 1000 openbao; \
    useradd --no-create-home --home-dir /vault --shell /usr/sbin/nologin \
      --uid 100 --gid 1000 openbao; \
    mkdir -p /vault/config /vault/data /vault/file /vault/logs; \
    chown -R 100:1000 /vault; \
    chmod -R g=u /vault
COPY --from=openbao-build /out/bao /usr/local/bin/vault
COPY --chmod=0755 compat/openbao/entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN ln -s vault /usr/local/bin/bao
ENV HOME=/vault
WORKDIR /vault
USER 100:1000
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD ["server"]

FROM data-runtime AS vault-k8s
COPY --from=vault-k8s-build /out/vault-k8s /usr/local/bin/vault-k8s
USER 65532:65532
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/vault-k8s"]

FROM data-runtime AS opensearch
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      bash curl openjdk-21-jre-headless procps; \
    rm -rf /var/lib/apt/lists/*; \
    useradd --no-create-home --home-dir /usr/share/opensearch --shell /usr/sbin/nologin \
      --uid 1000 --gid 0 opensearch; \
    mkdir -p /opt/bitnami/scripts/opensearch /usr/share/opensearch; \
    chown 1000:0 /usr/share/opensearch
COPY --from=opensearch-build --chown=1000:0 /out/opensearch /usr/share/opensearch
COPY --chmod=0755 compat/redis/liblog.sh /opt/bitnami/scripts/liblog.sh
COPY --chmod=0755 compat/opensearch/libfs.sh /opt/bitnami/scripts/libfs.sh
COPY --chmod=0755 compat/opensearch/opensearch-env.sh /opt/bitnami/scripts/opensearch-env.sh
COPY --chmod=0755 compat/opensearch/entrypoint.sh /opt/bitnami/scripts/opensearch/entrypoint.sh
COPY --chmod=0755 compat/opensearch/run.sh /opt/bitnami/scripts/opensearch/run.sh
COPY --chmod=0755 compat/opensearch/healthcheck.sh /opt/bitnami/scripts/opensearch/healthcheck.sh
COPY --from=opensearch_source --chmod=0755 /distribution/docker/src/docker/bin/docker-entrypoint.sh /usr/local/bin/opensearch-upstream-entrypoint
COPY --chmod=0755 compat/opensearch/entrypoint.sh /usr/local/bin/opensearch-entrypoint
RUN set -eux; \
    cp -a /usr/share/opensearch/config /usr/share/opensearch/config.default; \
    cp -a /usr/share/opensearch/plugins /usr/share/opensearch/plugins.default; \
    ln -s /usr/share/opensearch /opt/bitnami/opensearch; \
    mkdir -p /bitnami/opensearch/data /usr/share/opensearch/config/jvm.options.d \
      /usr/share/opensearch/data /usr/share/opensearch/logs; \
    chown -R 1000:0 /bitnami /opt/bitnami /usr/share/opensearch; \
    chmod -R g=u /bitnami /opt/bitnami /usr/share/opensearch
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64 \
    OPENSEARCH_CONTAINER=true \
    OPENSEARCH_HOME=/usr/share/opensearch \
    OPENSEARCH_JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64 \
    OPENSEARCH_PATH_CONF=/usr/share/opensearch/config \
    PATH=/usr/share/opensearch/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /usr/share/opensearch
USER 1000:0
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/opensearch-entrypoint"]
CMD ["opensearchwrapper"]

FROM data-runtime AS opensearch-dashboards
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y bash fontconfig; \
    rm -rf /var/lib/apt/lists/*; \
    useradd --no-create-home --home-dir /usr/share/opensearch-dashboards --shell /usr/sbin/nologin \
      --uid 1000 --gid 0 opensearch-dashboards; \
    mkdir -p /usr/share/opensearch-dashboards; \
    chown 1000:0 /usr/share/opensearch-dashboards
COPY --from=atum_node /opt/atum/node /opt/atum/node
COPY --from=opensearch-dashboards-build --chown=1000:0 /out/opensearch-dashboards /usr/share/opensearch-dashboards
COPY --chmod=0755 compat/opensearch-dashboards/entrypoint.sh /usr/local/bin/opensearch-dashboards-entrypoint
RUN set -eux; \
    ln -s /opt/atum/node /usr/share/opensearch-dashboards/node; \
    mkdir -p /usr/share/opensearch-dashboards/data; \
    chown -R 1000:0 /usr/share/opensearch-dashboards; \
    chmod -R g=u /usr/share/opensearch-dashboards
ENV PATH=/opt/atum/node/bin:/usr/share/opensearch-dashboards/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /usr/share/opensearch-dashboards
USER 1000:0
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/opensearch-dashboards-entrypoint"]
CMD ["/usr/share/opensearch-dashboards/bin/opensearch-dashboards"]

FROM data-runtime AS opensearch-operator
COPY --from=opensearch-operator-build /out/manager /manager
RUN ln -s /manager /usr/local/bin/opensearch-operator
USER 65532:65532
ENTRYPOINT ["/usr/bin/tini", "--", "/manager"]

FROM data-runtime AS velero
COPY --from=velero-build /out/velero /velero
RUN ln -s /velero /usr/local/bin/velero
USER 65532:65532
ENTRYPOINT ["/usr/bin/tini", "--", "/velero"]

FROM data-runtime AS velero-aws
RUN set -eux; mkdir -p /plugins /target
COPY --from=velero-aws-build /out/velero-plugin-for-aws /plugins/velero-plugin-for-aws
COPY --from=velero-aws-build /out/cp-plugin /bin/cp-plugin
USER 65532:65532
ENTRYPOINT ["/usr/bin/tini", "--", "/bin/cp-plugin", "/plugins/velero-plugin-for-aws", "/target/velero-plugin-for-aws"]
