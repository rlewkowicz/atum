FROM atum_go AS prometheus-operator-build
COPY --from=prometheus_operator_source / /src/prometheus-operator
WORKDIR /src/prometheus-operator
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    mkdir -p /out; \
    atum_ldflags='-s -w -X github.com/prometheus/common/version.Version=0.90.1 -X github.com/prometheus/common/version.Revision=32d1b3dfa05d070762450efe9624bb2483c782be -X github.com/prometheus/common/version.Branch=HEAD -X github.com/prometheus/common/version.BuildUser=atum -X github.com/prometheus/common/version.BuildDate=19700101-00:00:00'; \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags="$atum_ldflags" \
      -o /out/prometheus-operator ./cmd/operator & \
    atum_operator_pid=$!; \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags="$atum_ldflags" \
      -o /out/prometheus-config-reloader ./cmd/prometheus-config-reloader; \
    wait "$atum_operator_pid"

