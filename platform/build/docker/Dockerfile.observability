FROM observability-runtime AS grafana
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y bash curl tzdata; \
    rm -rf /var/lib/apt/lists/*; \
    groupadd --gid 472 grafana; \
    useradd --no-create-home --home-dir /usr/share/grafana --shell /usr/sbin/nologin --uid 472 --gid 472 grafana; \
    mkdir -p /etc/grafana/provisioning /usr/share/grafana /var/lib/grafana/plugins /var/log/grafana; \
    chown -R 472:472 /etc/grafana /usr/share/grafana /var/lib/grafana /var/log/grafana
COPY --from=grafana-build /out/grafana /usr/share/grafana/bin/grafana
COPY --from=grafana_source /conf /usr/share/grafana/conf
COPY --from=grafana_source /packaging/docker/run.sh /run.sh
COPY --from=grafana-ui-build /src/grafana/public /usr/share/grafana/public
COPY --chmod=0755 compat/grafana/entrypoint.sh /usr/local/bin/grafana-entrypoint
RUN set -eux; \
    cp /usr/share/grafana/conf/sample.ini /etc/grafana/grafana.ini; \
    cp /usr/share/grafana/conf/ldap.toml /etc/grafana/ldap.toml; \
    mkdir -p /opt/bitnami/grafana/conf /opt/bitnami/grafana/conf.default \
      /opt/bitnami/grafana/dashboards /opt/bitnami/grafana/data /opt/bitnami/grafana/tmp; \
    cp -a /usr/share/grafana/conf/. /opt/bitnami/grafana/conf.default/; \
    ln -s /tmp/grafana-logs /opt/bitnami/grafana/logs; \
    chmod 0755 /run.sh; \
    chown -R 472:472 /etc/grafana /opt/bitnami/grafana /usr/share/grafana; \
    chmod -R g=u /opt/bitnami/grafana
ENV GF_PATHS_CONFIG=/etc/grafana/grafana.ini \
    GF_PATHS_DATA=/var/lib/grafana \
    GF_PATHS_HOME=/usr/share/grafana \
    GF_PATHS_LOGS=/var/log/grafana \
    GF_PATHS_PLUGINS=/var/lib/grafana/plugins \
    GF_PATHS_PROVISIONING=/etc/grafana/provisioning \
    PATH=/usr/share/grafana/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /usr/share/grafana
USER 472:472
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/grafana-entrypoint"]

FROM observability-runtime AS k8s-sidecar
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      libbz2-1.0 libffi8 liblzma5 libreadline8t64 libsqlite3-0 libssl3t64 zlib1g; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p /app
COPY --from=atum_python /opt/atum/python /opt/atum/python
COPY --from=k8s-sidecar-build /out/venv /app/venv
ENV LD_LIBRARY_PATH=/opt/atum/python/lib \
    PATH=/app/venv/bin:/opt/atum/python/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PYTHONUNBUFFERED=1
WORKDIR /app
USER 65532:65532
ENTRYPOINT ["/usr/bin/tini", "--", "python", "-u", "-m", "sidecar"]
