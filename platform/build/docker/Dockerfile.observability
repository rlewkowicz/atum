FROM atum_runtime AS fluent-bit-build
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      bison \
      build-essential \
      cmake \
      flex \
      libcurl4-openssl-dev \
      libpq-dev \
      libsasl2-dev \
      libssl-dev \
      libsystemd-dev \
      libyaml-dev \
      pkg-config \
      zlib1g-dev; \
    rm -rf /var/lib/apt/lists/*
COPY --from=fluent_bit_source / /src/fluent-bit
WORKDIR /src/fluent-bit/build
RUN set -eux; \
    cmake \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/fluent-bit \
      -DFLB_CHUNK_TRACE=On \
      -DFLB_EXAMPLES=Off \
      -DFLB_HTTP_SERVER=On \
      -DFLB_IN_EXEC=Off \
      -DFLB_IN_SYSTEMD=On \
      -DFLB_JEMALLOC=On \
      -DFLB_LOG_NO_CONTROL_CHARS=On \
      -DFLB_OUT_KAFKA=On \
      -DFLB_OUT_PGSQL=On \
      -DFLB_RELEASE=On \
      -DFLB_SHARED_LIB=Off \
      -DFLB_SIMD=On \
      -DFLB_TLS=On \
      ..; \
    cmake --build . --parallel "$(nproc)"; \
    cmake --install . --prefix /out/fluent-bit; \
    mkdir -p /out/fluent-bit/etc; \
    cp -a \
      ../conf/fluent-bit.conf \
      ../conf/parsers.conf \
      ../conf/parsers_ambassador.conf \
      ../conf/parsers_cinder.conf \
      ../conf/parsers_extra.conf \
      ../conf/parsers_java.conf \
      ../conf/parsers_openstack.conf \
      ../conf/plugins.conf \
      /out/fluent-bit/etc/

FROM atum_go AS configmap-reload-build
COPY --from=configmap_reload_source / /src/configmap-reload
WORKDIR /src/configmap-reload
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' \
      -o /out/configmap-reload .

