FROM atum_node AS prometheus-ui-build
COPY --from=prometheus_source / /src/prometheus
WORKDIR /src/prometheus/web/ui
RUN --mount=type=cache,id=atum-prometheus-npm,target=/root/.npm,sharing=locked \
    set -eux; \
    npm ci --no-audit --no-fund; \
    npm --prefix react-app ci --no-audit --no-fund; \
    CI='' npm run build; \
    cd /src/prometheus; \
    scripts/compress_assets.sh; \
    test -s web/ui/embed.go; \
    test -n "$(find web/ui/static -type f -name '*.gz' -print -quit)"

