ARG ATUM_SOURCE_CONTEXT=source
FROM ${ATUM_SOURCE_CONTEXT} AS component-source

FROM atum_go AS component-build
ARG ATUM_BINARY
ARG ATUM_GO_LDFLAGS=-s -w
ARG ATUM_GO_PACKAGE=.
ARG ATUM_GO_TAGS=
ARG ATUM_GO_WORKDIR=.
COPY --from=component-source / /src/component
WORKDIR /src/component/${ATUM_GO_WORKDIR}
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    mkdir -p /out; \
    case "$ATUM_BINARY" in ""|*[!A-Za-z0-9._-]*) exit 64;; esac; \
    set -- -trimpath -buildvcs=false -ldflags "$ATUM_GO_LDFLAGS"; \
    if [ -n "$ATUM_GO_TAGS" ]; then set -- "$@" -tags "$ATUM_GO_TAGS"; fi; \
    CGO_ENABLED=0 go build "$@" -o "/out/$ATUM_BINARY" "$ATUM_GO_PACKAGE"

FROM atum_runtime AS runtime-base
ARG ATUM_BINARY
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE
ARG ATUM_IMAGE_TITLE
ARG ATUM_IMAGE_VERSION
COPY --from=component-build /out/ /usr/local/bin/
COPY --chmod=0755 compat/go/entrypoint.sh /usr/local/bin/atum-go-entrypoint
ENV ATUM_BINARY=${ATUM_BINARY}
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"
USER 65532:65532
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/atum-go-entrypoint"]

FROM runtime-base AS runtime

FROM runtime-base AS runtime-procps
USER 0:0
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y procps; \
    rm -rf /var/lib/apt/lists/*
USER 65532:65532

FROM runtime-base AS runtime-git
USER 0:0
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      git \
      gnupg \
      openssh-client; \
    rm -rf /var/lib/apt/lists/*
ENV GNUPGHOME=/tmp/gnupg
USER 65532:65532
