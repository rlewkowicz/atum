FROM atum_go AS kyverno-build
COPY --from=kyverno_source / /src/kyverno
WORKDIR /src/kyverno
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    mkdir -p /out; \
    atum_ldflags='-s -w -X github.com/kyverno/kyverno/pkg/version.BuildVersion=v1.17.1'; \
    atum_build() { \
      atum_output="$1"; \
      atum_package="$2"; \
      CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags="$atum_ldflags" \
        -o "/out/$atum_output" "$atum_package"; \
    }; \
    atum_build kyverno ./cmd/kyverno & atum_p1=$!; \
    atum_build kyvernopre ./cmd/kyverno-init & atum_p2=$!; \
    atum_build kubectl-kyverno ./cmd/cli/kubectl-kyverno & atum_p3=$!; \
    atum_build background-controller ./cmd/background-controller & atum_p4=$!; \
    atum_build cleanup-controller ./cmd/cleanup-controller & atum_p5=$!; \
    atum_build reports-controller ./cmd/reports-controller & atum_p6=$!; \
    atum_build readiness-checker ./cmd/readiness-checker; \
    wait "$atum_p1" "$atum_p2" "$atum_p3" "$atum_p4" "$atum_p5" "$atum_p6"

FROM atum_go AS policy-reporter-build
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y libsqlite3-dev; \
    rm -rf /var/lib/apt/lists/*
COPY --from=policy_reporter_source / /src/policy-reporter
WORKDIR /src/policy-reporter
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    mkdir -p /out; \
    CGO_ENABLED=1 go build -trimpath -buildvcs=false -tags=sqlite_unlock_notify \
      -ldflags='-s -w -X main.Version=3.7.3' -o /out/policyreporter .

FROM atum_go AS policy-reporter-plugin-build
COPY --from=policy_reporter_plugin_source / /src/policy-reporter-plugin
WORKDIR /src/policy-reporter-plugin/plugins/kyverno
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    mkdir -p /out; \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' \
      -o /out/policyreporter .

FROM atum_go AS policy-reporter-ui-build
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y curl unzip; \
    rm -rf /var/lib/apt/lists/*; \
    curl --fail --location --retry 6 \
      --output /tmp/bun.zip \
      https://github.com/oven-sh/bun/releases/download/bun-v1.3.5/bun-linux-x64.zip; \
    printf '%s  %s\n' \
      7051d86a924aefea3e0b96213b5fd8f79c0793f9cae6534233e627e5c3db4669 \
      /tmp/bun.zip | sha256sum --check; \
    unzip -q /tmp/bun.zip -d /tmp/bun; \
    install -m 0755 /tmp/bun/bun-linux-x64/bun /usr/local/bin/bun; \
    rm -rf /tmp/bun /tmp/bun.zip
COPY --from=policy_reporter_ui_source / /src/policy-reporter-ui
WORKDIR /src/policy-reporter-ui/frontend
RUN --mount=type=cache,id=atum-bun,target=/root/.bun/install/cache,sharing=shared \
    set -eux; \
    bun install --frozen-lockfile; \
    bun run generate
WORKDIR /src/policy-reporter-ui/backend
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    mkdir -p /out/kodata; \
    cp -a ../frontend/dist /out/kodata/ui; \
    cp -a templates /out/kodata/templates; \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false \
      -ldflags='-s -w -X main.Version=2.5.1' -o /out/policy-reporter-ui .

FROM atum_go AS kube-webhook-certgen-build
COPY --from=ingress_nginx_source /images/kube-webhook-certgen/rootfs /src/kube-webhook-certgen
WORKDIR /src/kube-webhook-certgen
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' \
      -o /out/kube-webhook-certgen .

FROM atum_runtime AS policy-runtime
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE
ARG ATUM_IMAGE_TITLE
ARG ATUM_IMAGE_VERSION
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"

FROM policy-runtime AS kyverno-admission-controller
COPY --from=kyverno-build /out/kyverno /usr/local/bin/kyverno
USER 65532:65532
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/kyverno"]

FROM policy-runtime AS kyverno-preflight
COPY --from=kyverno-build /out/kyvernopre /usr/local/bin/kyvernopre
USER 65532:65532
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/kyvernopre"]

FROM policy-runtime AS kyverno-cli
COPY --from=kyverno-build /out/kubectl-kyverno /usr/local/bin/kyverno
USER 65532:65532
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/kyverno"]

FROM policy-runtime AS kyverno-background-controller
COPY --from=kyverno-build /out/background-controller /usr/local/bin/background-controller
USER 65532:65532
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/background-controller"]

FROM policy-runtime AS kyverno-cleanup-controller
COPY --from=kyverno-build /out/cleanup-controller /usr/local/bin/cleanup-controller
USER 65532:65532
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/cleanup-controller"]

FROM policy-runtime AS kyverno-reports-controller
COPY --from=kyverno-build /out/reports-controller /usr/local/bin/reports-controller
USER 65532:65532
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/reports-controller"]

FROM policy-runtime AS kyverno-readiness-checker
COPY --from=kyverno-build /out/readiness-checker /usr/local/bin/readiness-checker
USER 65532:65532
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/readiness-checker"]

FROM policy-runtime AS policy-reporter
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y libsqlite3-0; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p /app
COPY --from=policy-reporter-build /out/policyreporter /app/policyreporter
COPY --from=policy_reporter_source /templates /app/templates
WORKDIR /app
USER 1234:1234
ENTRYPOINT ["/usr/bin/tini", "--", "/app/policyreporter", "run"]

FROM policy-runtime AS policy-reporter-ui
COPY --from=policy-reporter-ui-build /out/policy-reporter-ui /usr/local/bin/policy-reporter-ui
COPY --from=policy-reporter-ui-build /out/kodata /var/run/ko
ENV KO_DATA_PATH=/var/run/ko
USER 1234:1234
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/policy-reporter-ui"]

FROM policy-runtime AS policy-reporter-kyverno-plugin
WORKDIR /app
COPY --from=policy-reporter-plugin-build /out/policyreporter /app/policyreporter
USER 1234:1234
ENTRYPOINT ["/usr/bin/tini", "--", "/app/policyreporter"]

FROM policy-runtime AS kube-webhook-certgen
COPY --from=kube-webhook-certgen-build /out/kube-webhook-certgen /usr/local/bin/kube-webhook-certgen
USER 65532:65532
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/kube-webhook-certgen"]
