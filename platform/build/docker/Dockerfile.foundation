ARG ATUM_DEBIAN_IMAGE

FROM ${ATUM_DEBIAN_IMAGE} AS debian-runtime
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES=GPL-2.0-or-later
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE=https://github.com/debuerreotype/docker-debian-artifacts
ARG ATUM_IMAGE_TITLE=debian-runtime
ARG ATUM_IMAGE_VERSION=13-slim
ARG SOURCE_DATE_EPOCH=0
COPY compat/debian/debian.sources /etc/apt/sources.list.d/atum.sources
RUN set -eux; \
    rm -f /etc/apt/sources.list.d/debian.sources; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      ca-certificates \
      tini; \
    rm -rf /var/lib/apt/lists/*; \
    groupadd --gid 65532 atum; \
    useradd --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin \
      --uid 65532 --gid 65532 atum; \
    test "$(dpkg --print-architecture)" = amd64
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
LABEL org.opencontainers.image.authors="Atum maintainers" \
      org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.vendor="Atum" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"

FROM debian-runtime AS go-bootstrap-build
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      build-essential \
      git \
      golang-go; \
    rm -rf /var/lib/apt/lists/*
COPY --from=go_bootstrap_source / /opt/atum/go-bootstrap
RUN set -eux; \
    cd /opt/atum/go-bootstrap/src; \
    GOROOT_BOOTSTRAP="$(go env GOROOT)" ./make.bash

FROM go-bootstrap-build AS go-source-build
COPY --from=go_source / /opt/atum/go
RUN set -eux; \
    cd /opt/atum/go/src; \
    GOROOT_BOOTSTRAP=/opt/atum/go-bootstrap ./make.bash

FROM debian-runtime AS go-toolchain
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES=BSD-3-Clause
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE=https://go.googlesource.com/go
ARG ATUM_IMAGE_TITLE=go-toolchain
ARG ATUM_IMAGE_VERSION=1.26.3
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      build-essential \
      git \
      pkg-config; \
    rm -rf /var/lib/apt/lists/*
COPY --from=go-source-build /opt/atum/go /opt/atum/go
ENV GOROOT=/opt/atum/go \
    GOTOOLCHAIN=local \
    GOPATH=/go \
    PATH=/opt/atum/go/bin:/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"

FROM debian-runtime AS node-build-base
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      build-essential \
      libssl-dev \
      pkg-config \
      python3; \
    rm -rf /var/lib/apt/lists/*

FROM node-build-base AS node-20-build
COPY --from=node_20_source / /src/node
WORKDIR /src/node
RUN set -eux; \
    ./configure --prefix=/opt/atum/node; \
    make -j"$(nproc)"; \
    make install DESTDIR=/out

FROM node-build-base AS node-22-build
