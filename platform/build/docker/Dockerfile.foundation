FROM debian-runtime AS python-build
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      build-essential \
      libbz2-dev \
      libffi-dev \
      libgdbm-dev \
      liblzma-dev \
      libncurses-dev \
      libreadline-dev \
      libsqlite3-dev \
      libssl-dev \
      tk-dev \
      uuid-dev \
      zlib1g-dev; \
    rm -rf /var/lib/apt/lists/*
COPY --from=python_source / /src/python
WORKDIR /src/python
RUN set -eux; \
    ./configure --prefix=/opt/atum/python --enable-shared --with-ensurepip=install; \
    make -j"$(nproc)"; \
    make install DESTDIR=/out

FROM debian-runtime AS python-toolchain
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES=Python-2.0
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE=https://github.com/python/cpython
ARG ATUM_IMAGE_TITLE=python-toolchain
ARG ATUM_IMAGE_VERSION=3.12.12
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      build-essential \
      libbz2-dev \
      libffi-dev \
      libgdbm-dev \
      liblzma-dev \
      libncurses-dev \
      libreadline-dev \
      libsqlite3-dev \
      libssl-dev \
      uuid-dev \
      zlib1g-dev; \
    rm -rf /var/lib/apt/lists/*
COPY --from=python-build /out/opt/atum/python /opt/atum/python
ENV LD_LIBRARY_PATH=/opt/atum/python/lib \
    PATH=/opt/atum/python/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"

FROM debian-runtime AS ruby-build
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      autoconf \
      bison \
      build-essential \
      libffi-dev \
      libgdbm-dev \
      libgmp-dev \
      libreadline-dev \
      libssl-dev \
      libyaml-dev \
      pkg-config \
      ruby \
      rustc \
      zlib1g-dev; \
    rm -rf /var/lib/apt/lists/*
COPY --from=jemalloc_source / /src/jemalloc
WORKDIR /src/jemalloc
RUN set -eux; \
    ./autogen.sh --prefix=/opt/atum/jemalloc --enable-prof; \
    make -j"$(nproc)"; \
    make install; \
    mkdir -p /out/opt/atum; \
    cp -a /opt/atum/jemalloc /out/opt/atum/
COPY --from=ruby_source / /src/ruby
WORKDIR /src/ruby
RUN set -eux; \
    ./autogen.sh; \
    LDFLAGS='-Wl,-rpath,/opt/atum/jemalloc/lib' \
      ./configure \
        --prefix=/opt/atum/ruby \
        --disable-install-doc \
        --disable-install-rdoc \
        --enable-shared \
        --with-jemalloc \
        --with-opt-dir=/opt/atum/jemalloc; \
    make -j"$(nproc)"; \
    make install DESTDIR=/out

FROM debian-runtime AS ruby-toolchain
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES=Ruby AND BSD-2-Clause
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE=https://github.com/ruby/ruby
ARG ATUM_IMAGE_TITLE=ruby-toolchain
ARG ATUM_IMAGE_VERSION=3.3.10
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      build-essential \
      cargo \
      git \
      libffi-dev \
      libgdbm-dev \
      libgmp-dev \
      libicu-dev \
      libpq-dev \
      libreadline-dev \
      libssl-dev \
      libxml2-dev \
      libxslt1-dev \
      libyaml-dev \
      pkg-config \
      zlib1g-dev; \
    rm -rf /var/lib/apt/lists/*
COPY --from=ruby-build /out/opt/atum/jemalloc /opt/atum/jemalloc
COPY --from=ruby-build /out/opt/atum/ruby /opt/atum/ruby
ENV GEM_HOME=/opt/atum/ruby/lib/ruby/gems/3.3.0 \
    PATH=/opt/atum/ruby/bin:/opt/atum/ruby/lib/ruby/gems/3.3.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"

FROM debian-runtime AS busybox-build
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      build-essential \
      libtirpc-dev; \
    rm -rf /var/lib/apt/lists/*
COPY --from=busybox_source / /src/busybox
WORKDIR /src/busybox
RUN set -eux; \
    make defconfig; \
    sed -i 's/^# CONFIG_STATIC is not set$/CONFIG_STATIC=y/' .config; \
    sed -i 's/^CONFIG_TC=y$/# CONFIG_TC is not set/' .config; \
    make -j"$(nproc)"; \
    install -D -m 0755 busybox /out/busybox

FROM debian-runtime AS busybox
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES=GPL-2.0-only
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE=https://git.busybox.net/busybox
ARG ATUM_IMAGE_TITLE=busybox
ARG ATUM_IMAGE_VERSION=1.37.0
COPY --from=busybox-build /out/busybox /usr/local/bin/busybox
RUN set -eux; \
    /usr/local/bin/busybox --install -s /usr/local/bin
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"
CMD ["sh"]

FROM atum_go AS buildkit-build
COPY --from=buildkit_source / /src/buildkit
WORKDIR /src/buildkit
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    set -eux; \
    mkdir -p /out; \
    atum_ldflags="-s -w -X github.com/moby/buildkit/version.Version=v0.25.2 -X github.com/moby/buildkit/version.Revision=dcc0fe5e96ae78919b30057d0804c52f13a2eb7e -X github.com/moby/buildkit/version.Package=github.com/moby/buildkit"; \
    CGO_ENABLED=0 go build -mod=vendor -trimpath -buildvcs=false \
      -tags='osusergo netgo static_build seccomp' \
      -ldflags="$atum_ldflags -extldflags '-static'" \
      -o /out/buildkitd ./cmd/buildkitd & \
    atum_pid=$!; \
    CGO_ENABLED=0 go build -mod=vendor -trimpath -buildvcs=false \
      -ldflags="$atum_ldflags" -o /out/buildctl ./cmd/buildctl; \
    wait "$atum_pid"

FROM atum_runtime AS buildkit
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES=Apache-2.0
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE=https://github.com/moby/buildkit
ARG ATUM_IMAGE_TITLE=buildkit
ARG ATUM_IMAGE_VERSION=0.25.2
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      containerd \
      fuse3 \
      fuse-overlayfs \
      git \
      iproute2 \
      iptables \
      openssh-client \
      openssl \
      pigz \
      runc \
      xz-utils; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p /var/lib/buildkit
COPY --from=buildkit-build /out/buildkitd /out/buildctl /usr/local/bin/
VOLUME ["/var/lib/buildkit"]
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"
ENTRYPOINT ["/usr/local/bin/buildkitd"]

FROM atum_go AS sbom-scanner-build
COPY --from=sbom_scanner_source / /src/scanner
WORKDIR /src/scanner
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    set -eux; \
    mkdir -p /out; \
    CGO_ENABLED=0 go build -mod=vendor -trimpath -buildvcs=false \
      -ldflags='-s -w -extldflags -static -X github.com/docker/buildkit-syft-scanner/version.Version=v1.11.0 -X github.com/docker/buildkit-syft-scanner/version.SyftVersion=v1.42.3' \
      -o /out/syft-scanner ./cmd/syft-scanner

FROM atum_runtime AS sbom-scanner
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES=Apache-2.0
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE=https://github.com/docker/buildkit-syft-scanner
ARG ATUM_IMAGE_TITLE=sbom-scanner
ARG ATUM_IMAGE_VERSION=1.11.0
COPY --from=sbom-scanner-build /out/syft-scanner /usr/local/bin/syft-scanner
ENV LOG_LEVEL=warn
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"
ENTRYPOINT ["/usr/local/bin/syft-scanner"]

FROM atum_go AS kubectl-shell-build
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      bison \
      flex; \
    rm -rf /var/lib/apt/lists/*
COPY --from=kubernetes_source / /src/kubernetes
COPY --from=bash_source / /src/bash
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    set -eux; \
    mkdir -p /out; \
    (cd /src/bash && ./configure --prefix=/opt/atum/bash --disable-nls --without-bash-malloc && make -j"$(nproc)" && make install-strip) & \
    atum_pid=$!; \
    cd /src/kubernetes; \
    CGO_ENABLED=0 go build -mod=vendor -trimpath -buildvcs=false \
      -ldflags='-s -w \
        -X k8s.io/client-go/pkg/version.gitVersion=v1.36.1 \
        -X k8s.io/client-go/pkg/version.gitCommit=756939600b9a7180fc2df6550a4585b638875e67 \
        -X k8s.io/client-go/pkg/version.gitTreeState=clean \
        -X k8s.io/client-go/pkg/version.buildDate=1970-01-01T00:00:00Z \
        -X k8s.io/client-go/pkg/version.gitMajor=1 \
        -X k8s.io/client-go/pkg/version.gitMinor=36 \
        -X k8s.io/component-base/version.gitVersion=v1.36.1 \
        -X k8s.io/component-base/version.gitCommit=756939600b9a7180fc2df6550a4585b638875e67 \
        -X k8s.io/component-base/version.gitTreeState=clean \
        -X k8s.io/component-base/version.buildDate=1970-01-01T00:00:00Z \
        -X k8s.io/component-base/version.gitMajor=1 \
        -X k8s.io/component-base/version.gitMinor=36' \
      -o /out/kubectl ./cmd/kubectl; \
    wait "$atum_pid"

FROM atum_runtime AS kubectl-shell
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES=Apache-2.0 AND GPL-3.0-or-later
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE=https://github.com/kubernetes/kubernetes
ARG ATUM_IMAGE_TITLE=kubectl-shell
ARG ATUM_IMAGE_VERSION=1.36.1
COPY --from=kubectl-shell-build /out/kubectl /usr/local/bin/kubectl
COPY --from=kubectl-shell-build /opt/atum/bash/bin/bash /usr/local/bin/bash
RUN ln -sf /usr/local/bin/bash /bin/bash
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"
USER 65532:65532
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/bash"]

FROM atum_go AS build-job-compile
WORKDIR /src/atum
COPY --from=atum_source /go.mod /go.sum ./
COPY --from=atum_source /cli ./cli
COPY --from=docker_cli_source / /go/src/github.com/docker/cli
COPY --from=buildx_source / /src/buildx
RUN --mount=type=cache,id=atum-go-build,target=/root/.cache/go-build,sharing=shared \
    --mount=type=cache,id=atum-go-mod,target=/go/pkg/mod,sharing=shared \
    set -eux; \
    mkdir -p /out; \
    (cd /src/atum && CGO_ENABLED=0 go build -trimpath -buildvcs=false \
      -ldflags='-s -w' -o /out/atum ./cli/atum) & \
    atum_cli_pid=$!; \
    (cd /go/src/github.com/docker/cli && CGO_ENABLED=0 GO_LINKMODE=static VERSION=28.5.2 \
      GITCOMMIT=ecc694264de6b34e4b59d16245603382f22fa813 TARGET=/out ./scripts/build/binary) & \
    atum_docker_pid=$!; \
    (cd /src/buildx && CGO_ENABLED=0 DESTDIR=/out VERSION=v0.30.1 \
      REVISION=9e66234aa13328a5e75b75aa5574e1ca6d6d9c01 ./hack/build) & \
    atum_buildx_pid=$!; \
    wait "$atum_cli_pid" "$atum_docker_pid" "$atum_buildx_pid"; \
    install -m 0755 /out/docker-linux-amd64 /out/atum-docker

FROM atum_runtime AS build-job
ARG ATUM_IMAGE_CREATED=1970-01-01T00:00:00Z
ARG ATUM_IMAGE_LICENSES=Apache-2.0 AND BSD-3-Clause
ARG ATUM_IMAGE_REVISION
ARG ATUM_IMAGE_SOURCE=https://github.com/docker/buildx
ARG ATUM_IMAGE_TITLE=build-job
ARG ATUM_IMAGE_VERSION=1
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
      bash \
      curl \
      git \
      jq \
      make \
      openssh-client \
      ripgrep \
      skopeo; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p /usr/local/lib/docker/cli-plugins /workspace
COPY --from=atum_go /opt/atum/go /opt/atum/go
COPY --from=build-job-compile /out/atum-docker /usr/local/bin/docker
COPY --from=build-job-compile /out/docker-buildx /usr/local/lib/docker/cli-plugins/docker-buildx
COPY --from=build-job-compile /out/atum /usr/local/bin/atum
ENV GOROOT=/opt/atum/go \
    GOTOOLCHAIN=local \
    GOPATH=/go \
    PATH=/opt/atum/go/bin:/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /workspace
LABEL org.opencontainers.image.created="${ATUM_IMAGE_CREATED}" \
      org.opencontainers.image.licenses="${ATUM_IMAGE_LICENSES}" \
      org.opencontainers.image.revision="${ATUM_IMAGE_REVISION}" \
      org.opencontainers.image.source="${ATUM_IMAGE_SOURCE}" \
      org.opencontainers.image.title="${ATUM_IMAGE_TITLE}" \
      org.opencontainers.image.version="${ATUM_IMAGE_VERSION}"
CMD ["bash"]
