apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: atum-operator
  namespace: atum-system
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: atum-operator
  policyTypes: [Ingress, Egress]
  ingress: []
  egress:
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              k8s-app: kube-dns
      ports:
        - {protocol: UDP, port: 53}
        - {protocol: TCP, port: 53}
    - to:
        - ipBlock:
            cidr: 10.77.0.11/32
        - ipBlock:
            cidr: 10.77.0.12/32
        - ipBlock:
            cidr: 10.77.0.13/32
      ports:
        - {protocol: TCP, port: 6443}
    - to:
        - ipBlock:
            cidr: {{ .PublicIngressCIDR }}
        - ipBlock:
            cidr: {{ .PassthroughIngressCIDR }}
      ports:
        - {protocol: TCP, port: 443}
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: istio-gateway
          podSelector:
            matchExpressions:
              - key: app.kubernetes.io/name
                operator: In
                values:
                  - public-ingressgateway
                  - passthrough-ingressgateway
            matchLabels:
              istio: ingressgateway
      ports:
        - {protocol: TCP, port: 8443}
