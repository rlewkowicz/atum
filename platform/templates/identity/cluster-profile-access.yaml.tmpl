apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: platform-profile-access
  namespace: flux-system
spec:
  interval: 10m
  retryInterval: 2m
  timeout: 15m
  prune: true
  wait: true
  force: false
  postBuild:
    substitute:
      ATUM_PLATFORM_DOMAIN: ${ATUM_PLATFORM_DOMAIN}
    substituteFrom:
      - kind: Secret
        name: atum-platform-stateful
      - kind: Secret
        name: atum-platform-root-ca-public
  dependsOn:
    - name: platform-certificates
  sourceRef:
    kind: GitRepository
    name: flux-system
  path: ./platform/profiles/${ATUM_PLATFORM_PROFILE}/access
