apiVersion: v1
kind: Secret
metadata:
  name: atum-platform-identity-values
  namespace: bigbang
  labels:
    reconcile.fluxcd.io/watch: Enabled
  annotations:
    atum.dev/identity-digest: ${ATUM_IDENTITY_DIGEST}
type: Opaque
stringData:
  values.yaml: |
{{ indent 4 .Values }}
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: atum-sso-ca
  namespace: bigbang
spec:
  commonName: sso-ca.bigbang
  dnsNames:
    - sso-ca.bigbang
  duration: 8760h
  renewBefore: 720h
  issuerRef:
    group: cert-manager.io
    kind: ClusterIssuer
    name: atum-test-ca
  secretName: atum-sso-ca
