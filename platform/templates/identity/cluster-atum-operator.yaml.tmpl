apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: atum-operator
  namespace: flux-system
spec:
  interval: 10m
  retryInterval: 1m
  timeout: 15m
  prune: true
  wait: true
  force: false
  dependsOn:
    - name: platform-profile-access
  sourceRef:
    kind: GitRepository
    name: flux-system
  path: ./platform/apps/atum-operator
