apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: platform-certificates
  namespace: flux-system
spec:
  interval: 10m
  retryInterval: 1m
  timeout: 15m
  prune: true
  wait: true
  force: false
  dependsOn:
    - name: bigbang
  healthChecks:
    - apiVersion: helm.toolkit.fluxcd.io/v2
      kind: HelmRelease
      name: cert-manager
      namespace: bigbang
  sourceRef:
    kind: GitRepository
    name: flux-system
  path: ./platform/secrets/{{ .Cluster }}/pki
  decryption:
    provider: sops
    secretRef:
      name: atum-sops-age
