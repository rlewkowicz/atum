services:
  kubespray-files:
    image: ${kubespray_files_image}
    container_name: atum-kubespray-files
    restart: unless-stopped
    ports:
      - "${bastion_ip}:8080:8080"
    read_only: true
    tmpfs:
      - /var/cache/nginx:size=16m,mode=0755
      - /var/run:size=1m,mode=0755
    volumes:
      - /data/kubespray-files:/data:ro
      - /etc/atum/kubespray-files/nginx.conf:/etc/nginx/nginx.conf:ro
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    cap_add:
      - CHOWN
      - DAC_OVERRIDE
      - SETGID
      - SETUID
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--spider", "http://127.0.0.1:8080/healthz"]
      interval: 10s
      timeout: 3s
      retries: 30
      start_period: 5s
